     },
     {
      "grounding_chunk_indices": [
       11
      ],
      "segment": {
       "start_index": 3434,
       "end_index": 3542,
       "text": "* **Pricing (billed annually):**\n  * **Lite:** ~$14 per user/month (lead, calendar, and pipeline management)"
